[
    {
        "key": "group_brg_chrome_brand",
        "title": "Brand info — Content",
        "fields": [
            {
                "key": "field_brg_chrome_brand_msg",
                "label": "",
                "name": "",
                "type": "message",
                "message": "<strong>Brand info</strong> — site chrome, shown on every page. These are read directly by the plugin rather than filling a section's <code>{{slots}}</code>. A shortcode attribute still wins over anything saved here, for that one placement.",
                "new_lines": "wpautop",
                "esc_html": 0,
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "",
                    "class": "",
                    "id": ""
                }
            },
            {
                "key": "field_brg_brand_name",
                "label": "Business name",
                "name": "brg_brand_name",
                "type": "text",
                "instructions": "Used wherever the company is named in copy.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-name",
                    "id": ""
                },
                "default_value": "Blacktop Restaurant Group"
            },
            {
                "key": "field_brg_brand_email",
                "label": "Email address",
                "name": "brg_brand_email",
                "type": "text",
                "instructions": "The general enquiries address. Referenced as #brand-email in a link, or [brand email] in text. Becomes a mailto: link on its own — type just the address.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-email",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_phone",
                "label": "Phone number",
                "name": "brg_brand_phone",
                "type": "text",
                "instructions": "Written the way it should READ on the page, e.g. (760) 555-0134. Becomes a tel: link on its own, with everything except digits and a leading + stripped for the dialling part.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "100",
                    "class": "brg-f-phone",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_address",
                "label": "Address",
                "name": "brg_brand_address",
                "type": "textarea",
                "instructions": "Shown on the contact page and anywhere the location is named.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "100",
                    "class": "brg-f-address",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_careers_email",
                "label": "Careers email",
                "name": "brg_brand_careers_email",
                "type": "text",
                "instructions": "Where job enquiries go, if different from the general address. Referenced as #brand-careers_email.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-careers_email",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_instagram",
                "label": "Instagram",
                "name": "brg_brand_instagram",
                "type": "text",
                "instructions": "Full https:// address of the profile. Leave blank and nothing linking to it shows.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-instagram",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_facebook",
                "label": "Facebook",
                "name": "brg_brand_facebook",
                "type": "text",
                "instructions": "Full https:// address. Leave blank and nothing linking to it shows.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-facebook",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_tiktok",
                "label": "TikTok",
                "name": "brg_brand_tiktok",
                "type": "text",
                "instructions": "Full https:// address. Leave blank and nothing linking to it shows.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-tiktok",
                    "id": ""
                },
                "default_value": ""
            },
            {
                "key": "field_brg_brand_linkedin",
                "label": "LinkedIn",
                "name": "brg_brand_linkedin",
                "type": "text",
                "instructions": "Full https:// address. Leave blank and nothing linking to it shows.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-linkedin",
                    "id": ""
                },
                "default_value": "https://www.linkedin.com/company/blacktop-restaurant-group/"
            },
            {
                "key": "field_brg_brand_privacy",
                "label": "Privacy policy page",
                "name": "brg_brand_privacy",
                "type": "text",
                "instructions": "Path or full address of the privacy policy.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-privacy",
                    "id": ""
                },
                "default_value": "/privacy-policy/"
            },
            {
                "key": "field_brg_brand_footer_logo",
                "label": "Footer logo",
                "name": "brg_brand_footer_logo",
                "type": "image",
                "instructions": "The lockup shown in the middle of the footer on every page. It is artwork, not type — the words beside it in the code are only what a screen reader announces. An SVG keeps it crisp at any size; a PNG around 1400px wide also works. Leave empty to keep the built-in Blacktop lockup.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "100",
                    "class": "brg-f-footer_logo",
                    "id": ""
                },
                "return_format": "url",
                "preview_size": "medium",
                "library": "all"
            },
            {
                "key": "field_brg_brand_footer_logo_size",
                "label": "Footer logo width",
                "name": "brg_brand_footer_logo_size",
                "type": "number",
                "instructions": "How wide the footer logo is, in pixels. It has been 360 at full width, which reads small on a wide screen. It never grows past the space available, so a large number here simply means 'as big as it fits' on a phone.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "100",
                    "class": "brg-f-footer_logo_size",
                    "id": ""
                },
                "default_value": "360",
                "min": 120,
                "max": 720,
                "step": 10,
                "placeholder": "",
                "prepend": "",
                "append": "px"
            },
            {
                "key": "field_brg_brand_acc_admin_menu",
                "label": "Admin menu",
                "name": "",
                "type": "accordion",
                "instructions": "",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "",
                    "class": "brg-acc",
                    "id": ""
                },
                "open": 0,
                "multi_expand": 1,
                "endpoint": 0
            },
            {
                "key": "field_brg_brand_admin_menu_title",
                "label": "Menu name",
                "name": "brg_brand_admin_menu_title",
                "type": "text",
                "instructions": "What this whole area is called in the black sidebar on the left. It is \"Section Content\" today. Changing it renames the menu only — no page, address or saved content moves.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-admin_menu_title",
                    "id": ""
                },
                "default_value": "Section Content"
            },
            {
                "key": "field_brg_brand_admin_menu_icon",
                "label": "Menu icon — built-in",
                "name": "brg_brand_admin_menu_icon",
                "type": "text",
                "instructions": "A Dashicons name — the icon set WordPress ships with — for example dashicons-layout, dashicons-art or dashicons-screenoptions. The full list is at developer.wordpress.org/resource/dashicons. Ignored entirely if you upload your own below.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-admin_menu_icon",
                    "id": ""
                },
                "default_value": "dashicons-layout"
            },
            {
                "key": "field_brg_brand_admin_menu_position",
                "label": "Where it sits in the sidebar",
                "name": "brg_brand_admin_menu_position",
                "type": "number",
                "instructions": "Lower numbers sit higher. 2 puts it directly under Dashboard, at the very top, which is what it is set to. Posts is 5, Media 10, Pages 20, Appearance 60. A number already taken by another plugin can make one of the two disappear, so move in steps of 2.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-admin_menu_position",
                    "id": ""
                },
                "default_value": "2",
                "min": 1,
                "max": 100,
                "step": 1,
                "placeholder": "",
                "prepend": "",
                "append": ""
            },
            {
                "key": "field_brg_brand_admin_menu_icon_image",
                "label": "Menu icon — your own",
                "name": "brg_brand_admin_menu_icon_image",
                "type": "image",
                "instructions": "Upload or pick an icon from the Media Library instead. It wins over the built-in name beside it. A small square works best — WordPress draws it at 20 by 20 pixels — and a white or very light PNG or SVG reads properly against the dark sidebar. Leave it empty to use the built-in icon.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-admin_menu_icon_image",
                    "id": ""
                },
                "return_format": "url",
                "preview_size": "medium",
                "library": "all"
            },
            {
                "key": "field_brg_brand_admin_menu_pages",
                "label": "Order of the pages inside it",
                "name": "brg_brand_admin_menu_pages",
                "type": "repeater",
                "instructions": "DRAG THE ROWS to set the order they appear in the sidebar. Add a row per page you want to place; anything you leave out keeps its usual position after the ones you list, so you can add just two rows to pull those two to the top. Leave the list empty for the order they are generated in.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": 100,
                    "class": "brg-f-admin_menu_pages",
                    "id": ""
                },
                "layout": "block",
                "button_label": "Add a page",
                "min": 0,
                "max": 0,
                "collapsed": "field_brg_brand_admin_menu_pages_page",
                "sub_fields": [
                    {
                        "key": "field_brg_brand_admin_menu_pages_page",
                        "label": "Page",
                        "name": "page",
                        "type": "select",
                        "instructions": "Which page this row is.",
                        "required": 0,
                        "conditional_logic": 0,
                        "wrapper": {
                            "width": "100",
                            "class": "brg-f-page",
                            "id": ""
                        },
                        "default_value": "",
                        "choices": {
                            "": "— choose a page —",
                            "brg-section-content-home": "Home",
                            "brg-section-content-our-restaurants": "Brands",
                            "brg-section-content-team": "Team",
                            "brg-section-content-community": "Community",
                            "brg-section-content-careers": "Careers",
                            "brg-section-content-contact": "Contact",
                            "brg-section-content-brand": "Brand info",
                            "brg-section-content-site-wide": "Site-wide"
                        },
                        "return_format": "value",
                        "allow_null": 0,
                        "multiple": 0,
                        "ui": 0,
                        "ajax": 0,
                        "placeholder": ""
                    }
                ]
            },
            {
                "key": "field_brg_brand_endacc_admin_menu",
                "label": "",
                "name": "",
                "type": "accordion",
                "instructions": "",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "",
                    "class": "",
                    "id": ""
                },
                "open": 0,
                "multi_expand": 0,
                "endpoint": 1
            },
            {
                "key": "field_brg_chrome_brand_opts",
                "label": "Shortcode &amp; options",
                "name": "",
                "type": "message",
                "message": "<p>Any field on this page can also be set right in the shortcode — that wins over what is saved here, for that one placement. Extra option: <code>ttl=\"0\"</code> always fetches the newest copy.</p><table class=\"widefat striped\"><thead><tr><th>Option</th><th>Field</th><th>Value</th></tr></thead><tbody><tr><td><code>name</code></td><td>Business name</td><td>text</td></tr><tr><td><code>email</code></td><td>Email address</td><td>text</td></tr><tr><td><code>phone</code></td><td>Phone number</td><td>text</td></tr><tr><td><code>address</code></td><td>Address</td><td>text</td></tr><tr><td><code>careers_email</code></td><td>Careers email</td><td>text</td></tr><tr><td><code>instagram</code></td><td>Instagram</td><td>a link or page path</td></tr><tr><td><code>facebook</code></td><td>Facebook</td><td>a link or page path</td></tr><tr><td><code>tiktok</code></td><td>TikTok</td><td>a link or page path</td></tr><tr><td><code>linkedin</code></td><td>LinkedIn</td><td>a link or page path</td></tr><tr><td><code>privacy</code></td><td>Privacy policy page</td><td>a link or page path</td></tr><tr><td><code>footer_logo</code></td><td>Footer logo</td><td>an image URL</td></tr><tr><td><code>footer_logo_size</code></td><td>Footer logo width</td><td>a number (120–720)</td></tr><tr><td><code>admin_menu_title</code></td><td>Menu name</td><td>text</td></tr><tr><td><code>admin_menu_icon</code></td><td>Menu icon — built-in</td><td>text</td></tr><tr><td><code>admin_menu_position</code></td><td>Where it sits in the sidebar</td><td>a number (1–100)</td></tr><tr><td><code>admin_menu_icon_image</code></td><td>Menu icon — your own</td><td>an image URL</td></tr><tr><td><code>admin_menu_pages</code></td><td>Order of the pages inside it</td><td>text</td></tr></tbody></table>",
                "new_lines": "",
                "esc_html": 0,
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": 100,
                    "class": "",
                    "id": ""
                }
            }
        ],
        "location": [
            [
                {
                    "param": "options_page",
                    "operator": "==",
                    "value": "brg-section-content-brand"
                }
            ]
        ],
        "menu_order": 90,
        "position": "normal",
        "style": "default",
        "label_placement": "top",
        "instruction_placement": "label",
        "hide_on_screen": "",
        "active": true,
        "description": "Site chrome. Edit website/chrome/<id>/slots.json and rerun kit/build-acf.py."
    }
]
