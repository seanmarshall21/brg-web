[
    {
        "key": "group_brg_chrome_nav",
        "title": "Nav — Content",
        "fields": [
            {
                "key": "field_brg_chrome_nav_msg",
                "label": "",
                "name": "",
                "type": "message",
                "message": "<strong>Nav</strong> — site chrome, shown on every page. These are read directly by the plugin rather than filling a section's <code>{{slots}}</code>.",
                "new_lines": "wpautop",
                "esc_html": 0,
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "",
                    "class": "",
                    "id": ""
                }
            },
            {
                "key": "field_brg_nav_logo",
                "label": "Logo",
                "name": "brg_nav_logo",
                "type": "image",
                "instructions": "The mark in the bar. An SVG stays crisp at any size and is what the bar is built around. Leave empty and the bar falls back to the logo configured in the plugin.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-logo",
                    "id": ""
                },
                "return_format": "url",
                "preview_size": "medium",
                "library": "all"
            },
            {
                "key": "field_brg_nav_logo_size",
                "label": "Logo height",
                "name": "brg_nav_logo_size",
                "type": "number",
                "instructions": "How tall the logo is in the bar, in pixels. The design sits around 32. The bar sizes itself from its contents, so a taller logo makes a taller bar — and it still scales down when the page scrolls.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-logo_size",
                    "id": ""
                },
                "default_value": "32",
                "min": 16,
                "max": 96,
                "step": 1,
                "placeholder": "",
                "prepend": "",
                "append": "px"
            },
            {
                "key": "field_brg_nav_logo_href",
                "label": "Logo links to",
                "name": "brg_nav_logo_href",
                "type": "text",
                "instructions": "Where clicking the logo goes. Normally the home page. Worth checking if a temporary landing page is ever sitting at the root.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-logo_href",
                    "id": ""
                },
                "default_value": "/"
            },
            {
                "key": "field_brg_nav_link_size",
                "label": "Link size",
                "name": "brg_nav_link_size",
                "type": "number",
                "instructions": "The size of the words in the bar, in pixels. The design sits around 13.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-link_size",
                    "id": ""
                },
                "default_value": "13",
                "min": 9,
                "max": 22,
                "step": 1,
                "placeholder": "",
                "prepend": "",
                "append": "px"
            },
            {
                "key": "field_brg_nav_link_gap",
                "label": "Space between links",
                "name": "brg_nav_link_gap",
                "type": "number",
                "instructions": "The gap between one link and the next, in pixels. Tighten this before reducing the size when a long menu is close to wrapping.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-link_gap",
                    "id": ""
                },
                "default_value": "26",
                "min": 8,
                "max": 64,
                "step": 1,
                "placeholder": "",
                "prepend": "",
                "append": "px"
            },
            {
                "key": "field_brg_nav_left",
                "label": "Links before the logo",
                "name": "brg_nav_left",
                "type": "number",
                "instructions": "Only used by the layouts that put links on both sides of a centered logo. Anything past this count moves into the More menu rather than crowding the bar.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-left",
                    "id": ""
                },
                "default_value": "2",
                "min": 0,
                "max": 8,
                "step": 1,
                "placeholder": "",
                "prepend": "",
                "append": ""
            },
            {
                "key": "field_brg_nav_right",
                "label": "Links after the logo",
                "name": "brg_nav_right",
                "type": "number",
                "instructions": "As above, for the other side. On a logo-left layout this is the only one that counts.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-right",
                    "id": ""
                },
                "default_value": "2",
                "min": 0,
                "max": 8,
                "step": 1,
                "placeholder": "",
                "prepend": "",
                "append": ""
            },
            {
                "key": "field_brg_nav_more_label",
                "label": "“More” label",
                "name": "brg_nav_more_label",
                "type": "text",
                "instructions": "The wording on the button that opens the overflow menu when there are more links than fit the counts above.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-more_label",
                    "id": ""
                },
                "default_value": "More"
            },
            {
                "key": "field_brg_nav_follow_label",
                "label": "Social heading, in the phone menu",
                "name": "brg_nav_follow_label",
                "type": "text",
                "instructions": "The small heading above the social icons inside the phone menu.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-follow_label",
                    "id": ""
                },
                "default_value": "Follow"
            },
            {
                "key": "field_brg_nav_show_numbers",
                "label": "Number the phone menu",
                "name": "brg_nav_show_numbers",
                "type": "select",
                "instructions": "The 01, 02, 03 running down the phone menu. Off leaves just the words.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-show_numbers",
                    "id": ""
                },
                "default_value": "1",
                "choices": {
                    "1": "Numbered",
                    "0": "No numbers"
                },
                "return_format": "value",
                "allow_null": 0,
                "multiple": 0,
                "ui": 0,
                "ajax": 0,
                "placeholder": ""
            },
            {
                "key": "field_brg_nav_show_social",
                "label": "Social row in the phone menu",
                "name": "brg_nav_show_social",
                "type": "select",
                "instructions": "Whether the social icons appear at the foot of the phone menu. They come from the menu assigned to BRG — Social under Appearance → Menus; hiding them here leaves that menu alone.",
                "required": 0,
                "conditional_logic": 0,
                "wrapper": {
                    "width": "50",
                    "class": "brg-f-show_social",
                    "id": ""
                },
                "default_value": "1",
                "choices": {
                    "1": "Shown",
                    "0": "Hidden"
                },
                "return_format": "value",
                "allow_null": 0,
                "multiple": 0,
                "ui": 0,
                "ajax": 0,
                "placeholder": ""
            }
        ],
        "location": [
            [
                {
                    "param": "options_page",
                    "operator": "==",
                    "value": "brg-section-content-nav"
                }
            ]
        ],
        "menu_order": 90,
        "position": "normal",
        "style": "default",
        "label_placement": "top",
        "instruction_placement": "label",
        "hide_on_screen": "",
        "active": true,
        "description": "Site chrome. Edit website/chrome/nav/slots.json and rerun kit/build-acf.py."
    }
]
