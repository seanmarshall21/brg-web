#!/usr/bin/env python3
"""BRG territory guard.

Refuses (or warns about) a commit that stages a file owned by another chat.
The whole point of clone-per-chat is that two chats can't collide in a working
tree — this catches the other half, where a chat edits a file that isn't its
job to edit, which no amount of process isolation prevents.

Config (all repo-local, set by .githooks/install.sh):
    fc.chat      this clone's chat id. UNSET => hook is inert (exit 0), so a
                 human clone or CI never gets blocked by a rule meant for chats.
    fc.enforce   warn (default) | block

Escape hatch: FC_ALLOW_CROSS=1 git commit ...
"""

import os
import subprocess
import sys
from fnmatch import fnmatch

HERE = os.path.dirname(os.path.abspath(__file__))
MAP = os.path.join(HERE, "territory.tsv")

# Files that legitimately live at the repo root. Anything else staged there is
# almost certainly scratch output — see the disclosure guard in main().
ROOT_ALLOWED = {
    ".gitignore", "CLAUDE.md", "GO-LIVE.md", "HANDOFF.md", "KICKOFF.md",
    "MANIFESTO.md", "README.md", "SHORTCODES.md", "STATUS.md", "netlify.toml",
}


def git(*args):
    return subprocess.run(
        ["git", *args], capture_output=True, text=True
    ).stdout.strip()


def load_map():
    rows = []
    if not os.path.exists(MAP):
        return rows
    with open(MAP, encoding="utf-8") as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 2:
                continue
            owner, pattern = parts[0].strip(), parts[1].strip()
            if owner and pattern:
                rows.append((owner, pattern))
    return rows


def owner_of(path, rows):
    """Longest matching pattern wins. Returns (owner, pattern) or (None, None)."""
    best = (None, None)
    for owner, pattern in rows:
        if pattern.endswith("/"):
            hit = path.startswith(pattern)
        elif "*" in pattern:
            hit = fnmatch(path, pattern)
        else:
            hit = path == pattern
        if hit and (best[1] is None or len(pattern) > len(best[1])):
            best = (owner, pattern)
    return best


def main():
    chat = git("config", "fc.chat")
    if not chat:
        return 0  # not a chat clone — nothing to enforce

    staged = [
        p
        for p in git(
            "diff", "--cached", "--name-only", "--diff-filter=ACMRD"
        ).splitlines()
        if p
    ]
    if not staged:
        return 0

    # ── Disclosure guard ──────────────────────────────────────────────────
    # Everything else in this hook is about the WRONG PERSON editing a file.
    # This is about the wrong FILE existing at all, which is a different and
    # worse failure: on 2026-08-13 a cd failed silently, a scratch run wrote a
    # dump of the live PASSWORD-GATED page into the clone, and only luck and an
    # untracked status stopped it. `git add -A` is banned in CLAUDE.md but that
    # ban relies on recall, and the territory check above cannot help — an
    # untracked file in your OWN territory passes ownership cleanly.
    #
    # Wrong answers can be corrected. A live page dump on a public CDN cannot.
    scratch = []
    for path in staged:
        if "/" not in path and path not in ROOT_ALLOWED:
            scratch.append((path, "new file at the repo root — scratch output lands "
                                  "where the process ran, and that is usually here"))
            continue
        try:
            with open(path, "rb") as fh:
                head = fh.read(200_000).lower()
        except OSError:
            continue
        # `startswith`, not `in`: a captured page BEGINS with the doctype. Matching
        # anywhere made this hook flag its own source, because the literals it
        # searches for are in it — the detector detected itself on first use.
        if (head.lstrip().startswith(b"<!doctype html")
                and b"wp-content" in head
                and not path.startswith("website/")):
            scratch.append((path, "looks like a captured WordPress page (doctype + wp-content) "
                                  "outside website/ — a live-page dump, possibly from behind the gate"))

    if scratch:
        print()
        print("DISCLOSURE GUARD: refusing %d staged file(s)." % len(scratch))
        for path, why in scratch:
            print("    !  %s" % path)
            print("       %s" % why)
        print()
        print("    This one does not warn. A wrong answer can be corrected; a live page")
        print("    dump on a public CDN cannot. Move it out of the repo, or add it to")
        print("    ROOT_ALLOWED in this hook if it genuinely belongs at the root.")
        print()
        return 1

    rows = load_map()
    if not rows:
        print("territory: no .githooks/territory.tsv — ownership check skipped.")
        return 0

    # The override is deliberately BELOW the disclosure guard. FC_ALLOW_CROSS exists
    # to let someone edit another seat's file after saying so out loud — it is not a
    # licence to commit a live page dump, and before this reorder it silently was one.
    if os.environ.get("FC_ALLOW_CROSS") == "1":
        print("territory: FC_ALLOW_CROSS=1 — ownership check skipped (disclosure guard still ran).")
        return 0

    violations, unmapped = [], []
    for path in staged:
        owner, pattern = owner_of(path, rows)
        if owner is None:
            unmapped.append(path)
        elif owner not in (chat, "*"):
            violations.append((path, owner, pattern))

    if unmapped:
        print(f"territory: {len(unmapped)} unmapped path(s) — allowed, but nobody owns them:")
        for path in unmapped:
            print(f"    ?  {path}")
        print("    → add a row to .githooks/territory.tsv (conti owns the map).")

    if not violations:
        return 0

    mode = git("config", "fc.enforce") or "warn"
    label = "BLOCKED" if mode == "block" else "WARNING"

    print()
    print(f"territory {label}: this clone is `{chat}`, but {len(violations)} staged "
          f"file(s) belong to someone else:")
    for path, owner, pattern in violations:
        print(f"    ✗  {path}")
        print(f"       owned by {owner}  (rule: {pattern})")
    print()
    print("    Right move: ask the owner in notes/roundtable.md, or open a task in")
    print("    notes/tasks.json. If the change genuinely has to happen here, say so")
    print("    out loud and re-run with:  FC_ALLOW_CROSS=1 git commit ...")

    if mode == "block":
        print()
        return 1

    print("    (warn mode — commit proceeding)")
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
