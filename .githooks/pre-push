#!/usr/bin/env bash
# BRG pre-push checks — cheap, and each one exists because something broke once.
#
#   1. kit/build.py --check   generated docs (SHORTCODES.md, docs/shortcode-index.html)
#                             must match kit/registry.json, and a moved contract must
#                             carry a version bump. Docs drift is silent otherwise.
#   2. node --check           every changed .js/.mjs parses. brgw.js is INLINED into
#                             the WP page — a syntax error takes the page down, not
#                             just the script.
#   3. php -l                 every changed .php parses. A fatal in an mu-plugin is a
#                             white screen on the live site.
#
# A missing interpreter prints SKIPPED and does not fail the push — this repo has no
# local PHP, and a check you can't run is not a reason to be unable to ship.
#
# Bypass (deliberately loud): git push --no-verify

set -uo pipefail

fail=0
say() { printf '  %-26s %s\n' "$1" "$2"; }

echo "pre-push checks"

# ── Work out what's actually being pushed ────────────────────────────────────
# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
range=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # deleting a ref — nothing to check
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;          # normal update
    *)                                                  # new branch / no remote yet
      if git rev-parse --verify -q origin/main >/dev/null; then
        range="origin/main..$local_sha"
      else
        range="$local_sha"
      fi
      ;;
  esac
done

if [ -z "$range" ]; then
  # Invoked without the stdin protocol (or nothing parsed) — fall back to the
  # only thing that's reliably meaningful here.
  if git rev-parse --verify -q origin/main >/dev/null; then
    range="origin/main..HEAD"
  else
    range="HEAD"
  fi
fi

changed=$(git diff --name-only --diff-filter=ACMR "$range" 2>/dev/null || git show --name-only --pretty=format: "$range" 2>/dev/null)

# ── 1. generated docs ────────────────────────────────────────────────────────
if [ -f kit/build.py ]; then
  if command -v python3 >/dev/null 2>&1; then
    if out=$(python3 kit/build.py --check 2>&1); then
      say "kit/build.py --check" "OK"
    else
      say "kit/build.py --check" "FAILED"
      echo "$out" | sed 's/^/      /'
      echo "      → run: python3 kit/build.py   (and --restamp if a contract moved)"
      fail=1
    fi
  else
    say "kit/build.py --check" "SKIPPED (no python3)"
  fi
fi

# ── 1b. ACF: slots <-> tokens, and generated groups <-> declarations ─────────
# Two separate failures, both of which have happened:
#   --check          a slot with no {{token}} (field edits nothing) or a token with no
#                    slot (copy vanishes on render).
#   regenerate+diff  a section wired but its field group NEVER GENERATED. website/acf/ is
#                    conti's and slots.json is finn's, so a wiring can be complete on one
#                    side of the territory line and absent on the other. community-stats
#                    shipped that way: it rendered perfectly, --check was green, and twelve
#                    fields did not exist in WordPress.
# The regenerate step REWRITES website/acf/ — that rewrite IS the fix, so on failure just
# `git add website/acf/` and push again.
if [ -f kit/build-kit.py ] && command -v python3 >/dev/null 2>&1; then
  if out=$(python3 kit/build-kit.py --check 2>&1); then
    say "kit pages --check" "OK"
  else
    say "kit pages --check" "STALE"
    echo "$out" | sed 's/^/      /'
    echo "      → run: python3 kit/build-kit.py"
    fail=1
  fi
fi

if [ -f kit/build-acf.py ]; then
  if command -v python3 >/dev/null 2>&1; then
    if out=$(python3 kit/build-acf.py --check 2>&1); then
      say "build-acf.py --check" "OK"
    else
      say "build-acf.py --check" "FAILED"
      echo "$out" | sed 's/^/      /'
      fail=1
    fi
    if python3 kit/build-acf.py >/dev/null 2>&1; then
      # --porcelain, not `git diff`: a brand-new section's group file is UNTRACKED after
      # regeneration, and git diff cannot see untracked files. all.acf.json would catch it
      # anyway (it is the combined file, so it always moves too) — but only by luck, and a
      # check that works by luck reports the wrong thing the day it doesn't.
      acfdirty=$(git status --porcelain -- website/acf/ 2>/dev/null)
      if [ -z "$acfdirty" ]; then
        say "acf groups current" "OK"
      else
        say "acf groups current" "STALE — regenerated, now commit them"
        echo "$acfdirty" | sed 's/^/      /'
        echo "      → these sections would have NO fields in WordPress. Run:"
        echo "        git add website/acf/ && git commit --amend --no-edit"
        fail=1
      fi
    fi
  else
    say "build-acf.py" "SKIPPED (no python3)"
  fi
fi

# ── 2. JavaScript ────────────────────────────────────────────────────────────
js=$(echo "$changed" | grep -E '\.(js|mjs)$' || true)
if [ -n "$js" ]; then
  if command -v node >/dev/null 2>&1; then
    n=0
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      if ! out=$(node --check "$f" 2>&1); then
        say "node --check" "FAILED  $f"
        echo "$out" | sed 's/^/      /'
        fail=1
      fi
      n=$((n + 1))
    done <<< "$js"
    [ "$fail" -eq 0 ] && say "node --check" "OK ($n file(s))"
  else
    say "node --check" "SKIPPED (no node)"
  fi
fi

# ── 3. PHP ───────────────────────────────────────────────────────────────────
php=$(echo "$changed" | grep -E '\.php$' || true)
if [ -n "$php" ]; then
  if command -v php >/dev/null 2>&1; then
    n=0
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      if ! out=$(php -l "$f" 2>&1); then
        say "php -l" "FAILED  $f"
        echo "$out" | sed 's/^/      /'
        fail=1
      fi
      n=$((n + 1))
    done <<< "$php"
    [ "$fail" -eq 0 ] && say "php -l" "OK ($n file(s))"
  else
    say "php -l" "SKIPPED (no php) — $(echo "$php" | wc -l | tr -d ' ') changed .php UNVERIFIED"
  fi
fi

# ── Drift: one fact held in two places ──────────────────────────────────────────
# BLOCKS, and the change from warn to block is the point of this incident rather
# than a tightening for its own sake.
#
# The warn version fired correctly on the push that shipped a stale lab-cards.js —
# and I never saw it, because my push command ended in `| tail -1` and discarded
# everything above the last line. Sean then reviewed A5 and A6 with their headline
# text still tinted, on a fix I had told him was complete. A guard whose only effect
# is output can be defeated by a pipe; a non-zero exit cannot.
#
# This does not contradict "report when you can only inform" — a stale promoted copy
# is not informational. It put a wrong page in front of the person reviewing it, for
# several rounds, and the symptom (a partial fix) reads as a failed fix.
#
# The register is notes/explorer/studies/drift-register.json (expo's, SPEC-011). One
# JSON entry adds a pair; there is no second list to keep in step here, which is the
# whole argument for replacing the three hand-written comparisons this used to hold.
#
# Mid-edit escape, because the source owner editing their own file is a legitimate
# state and blocking that would be the cries-wolf failure:
#     FC_ALLOW_DRIFT=1 git push …
DRIFT=notes/explorer/studies/check-drift.py
if [ -n "${FC_ALLOW_DRIFT:-}" ]; then
  say "drift" "SKIPPED (FC_ALLOW_DRIFT=1)"
elif [ ! -f "$DRIFT" ]; then
  # Expo's territory. A missing checker must not block a push, but silence here would
  # read as a pass — which is the exact failure this file keeps recording.
  say "drift" "SKIPPED — $DRIFT not found (register unchecked)"
elif ! command -v python3 >/dev/null 2>&1; then
  say "drift" "SKIPPED (no python3)"
# --owner: block only on pairs this clone can actually resolve. Expo hit the flaw
# immediately — the three copy pairs are conti-owned and structurally diverged between
# their build and my promotion, so a global gate blocks the AUTHOR on something only the
# PROMOTER may fix. website/kit/ is not theirs to touch. A guard that fires on work you
# are not allowed to do gets bypassed reflexively, and then it means nothing.
#
# The flag is passed unconditionally: check-drift.py reads argv by membership, so an
# unsupported --owner is ignored and behaves exactly as today. Forward-compatible, and
# correct the moment expo adds it.
elif out=$(python3 "$DRIFT" --strict --owner "$(git config fc.chat)" 2>&1); then
  # Exit 0 answers "may I proceed", NOT "is anything wrong". With --owner, a pair that is
  # stale but owned by someone else exits 0 — and printing a bare OK over that made the two
  # states indistinguishable. Expo read `drift OK` with two conti-owned pairs diverged and
  # told Sean a section had shipped that had not. That window — between their build and my
  # promotion — is exactly when they most need telling, and it was the one state rendered
  # as clean. Filtering what BLOCKS you is right; filtering what you are TOLD is not.
  n=$(printf '%s\n' "$out" | grep -c 'DIVERGED' || true)
  if [ "${n:-0}" -gt 0 ]; then
    say "drift" "OK — $n diverged, none yours"
    printf '%s\n' "$out" | grep 'DIVERGED' | sed 's/^/        /'
  else
    say "drift" "OK"
  fi
else
  say "drift" "DIVERGED"
  echo "$out" | sed 's/^/        /'
  echo "        promote the copy, or FC_ALLOW_DRIFT=1 if the source is mid-edit"
  fail=1
fi


if [ "$fail" -ne 0 ]; then
  echo
  echo "  push refused. Fix the above, or bypass with: git push --no-verify"
  exit 1
fi

exit 0
